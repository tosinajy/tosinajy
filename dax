SLA 5 Time =
VAR StartDate =
    MAX ( FactClientWorkflow[checklist_complete], FactClientWorkflow[verif_complete] )
RETURN
IF (
    ISBLANK ( FactClientWorkflow[checklist_complete] )
        || ISBLANK ( FactClientWorkflow[verif_complete] ),
    0,
    IF (
        NOT ISBLANK ( FactClientWorkflow[sent_to_client] ),
        NETWORKDAYS ( StartDate, FactClientWorkflow[sent_to_client] ),
        NETWORKDAYS ( StartDate, TODAY() )
    )
)

SLA 5 Status =
SWITCH (
    TRUE(),
    ISBLANK ( FactClientWorkflow[checklist_complete] )
        || ISBLANK ( FactClientWorkflow[verif_complete] ), "Not In process yet",
    NOT ISBLANK ( FactClientWorkflow[sent_to_client] ) && FactClientWorkflow[SLA 5 Time] > 4, "Completed Exceeded Time",
    NOT ISBLANK ( FactClientWorkflow[sent_to_client] ), "Completed On Time",
    FactClientWorkflow[SLA 5 Time] > 4, "Open Exceeded Time",
    FactClientWorkflow[SLA 5 Time] > 2, "Open At Risk",
