{
  "name": "Premium Client Health Theme",
  "dataColors": [
    "#2563EB",
    "#16A34A",
    "#F59E0B",
    "#DC2626",
    "#7C3AED",
    "#0891B2",
    "#6B7280",
    "#111827"
  ],
  "background": "#F8FAFC",
  "foreground": "#111827",
  "tableAccent": "#2563EB",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 10
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#2563EB"
              }
            }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "outlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#111827"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#111827"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#6B7280"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#111827"
    }
  }
}
