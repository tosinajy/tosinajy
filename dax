Total Files Received =
CALCULATE (
    DISTINCTCOUNT ( FactClientWorkflow[WorkflowKey] ),
    NOT ISBLANK ( FactClientWorkflow[rqst_rcvd] )
)

Total Files Completed =
CALCULATE (
    DISTINCTCOUNT ( FactClientWorkflow[WorkflowKey] ),
    NOT ISBLANK ( FactClientWorkflow[sent_to_client] )
)

Files In Progress =
CALCULATE (
    DISTINCTCOUNT ( FactClientWorkflow[WorkflowKey] ),
    ISBLANK ( FactClientWorkflow[sent_to_client] ),
    NOT ISBLANK ( FactClientWorkflow[rqst_rcvd] )
)

Completed On Time Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] = "Completed On Time"
)

Completed SLA Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] IN {
        "Completed On Time",
        "Completed Exceeded Time"
    }
)

Completed On Time % =
DIVIDE ( [Completed On Time Count], [Completed SLA Count] )

Completed Out of Compliance Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] = "Completed Exceeded Time"
)

Completed Out of Compliance % =
DIVIDE ( [Completed Out of Compliance Count], [Completed SLA Count] )




In Progress SLA Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] IN {
        "Open",
        "Open At Risk",
        "Open Exceeded Time"
    }
)

In Progress Out of Compliance Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] = "Open Exceeded Time"
)

In Progress Out of Compliance % =
DIVIDE ( [In Progress Out of Compliance Count], [In Progress SLA Count] )



In Progress At Risk Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] = "Open At Risk"
)

In Progress At Risk % =
DIVIDE ( [In Progress At Risk Count], [In Progress SLA Count] )



Average Business Days by SLA Stage =
AVERAGE ( FactWorkflowSLA[StageElapsedDays] )

DimSLAStage[SLA Stage]



Median Business Days by SLA Stage =
MEDIAN ( FactWorkflowSLA[StageElapsedDays] )



End-to-End Cycle Time =
CALCULATE (
    AVERAGE ( FactWorkflowSLA[StageElapsedDays] ),
    FactWorkflowSLA[SLAStageKey] = 7
)

End-to-End Cycle Time Completed Only =
CALCULATE (
    AVERAGE ( FactWorkflowSLA[StageElapsedDays] ),
    FactWorkflowSLA[SLAStageKey] = 7,
    FactWorkflowSLA[SLAStatus] IN {
        "Completed On Time",
        "Completed Exceeded Time"
    }
)



Recred Completed Before Expiration Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStageKey] = 8,
    FactWorkflowSLA[SLAStatus] = "Completed On Time"
)

Recred Completed Count =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStageKey] = 8,
    FactWorkflowSLA[SLAStatus] IN {
        "Completed On Time",
        "Completed Exceeded Time"
    }
)

Recred Files Completed Before Expiration % =
DIVIDE (
    [Recred Completed Before Expiration Count],
    [Recred Completed Count]
)



Backlog by SLA Stage =
CALCULATE (
    COUNTROWS ( FactWorkflowSLA ),
    FactWorkflowSLA[SLAStatus] IN {
        "Open",
        "Open At Risk",
        "Open Exceeded Time"
    }
)


Highest Backlog Stage =
VAR StageBacklogTable =
    ADDCOLUMNS (
        VALUES ( DimSLAStage[SLA Stage] ),
        "BacklogCount", [Backlog by SLA Stage]
    )
VAR TopStage =
    TOPN (
        1,
        StageBacklogTable,
        [BacklogCount],
        DESC
    )
RETURN
    CONCATENATEX (
        TopStage,
        DimSLAStage[SLA Stage],
        ", "
    )


Highest Backlog Stage Count =
MAXX (
    ADDCOLUMNS (
        VALUES ( DimSLAStage[SLA Stage] ),
        "BacklogCount", [Backlog by SLA Stage]
    ),
    [BacklogCount]
)


