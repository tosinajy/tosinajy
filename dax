SLA 1 Time =
IF (
    ISBLANK ( FactClientWorkflow[rqst_rcvd] ),
    0,
    IF (
        NOT ISBLANK ( FactClientWorkflow[app_rcvd] ),
        NETWORKDAYS ( FactClientWorkflow[rqst_rcvd], FactClientWorkflow[app_rcvd] ),
        NETWORKDAYS ( FactClientWorkflow[rqst_rcvd], TODAY() )
    )
)

SLA 1 Status =
SWITCH (
    TRUE(),
    ISBLANK ( FactClientWorkflow[rqst_rcvd] ), "Not In process yet",
    NOT ISBLANK ( FactClientWorkflow[app_rcvd] ) && FactClientWorkflow[SLA 1 Time] > 5, "Completed Exceeded Time",
    NOT ISBLANK ( FactClientWorkflow[app_rcvd] ), "Completed On Time",
    FactClientWorkflow[SLA 1 Time] > 5, "Open Exceeded Time",
    FactClientWorkflow[SLA 1 Time] > 3, "Open At Risk",
    "Open"
)

