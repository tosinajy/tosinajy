SLA 8 Time =
IF (
    FactClientWorkflow[apptmnt_type] = "I",
    0,
    IF (
        ISBLANK ( FactClientWorkflow[prior_appt_end] ),
        0,
        IF (
            NOT ISBLANK ( FactClientWorkflow[sent_to_client] ),
            DATEDIFF ( FactClientWorkflow[prior_appt_end], FactClientWorkflow[sent_to_client], DAY ),
            DATEDIFF ( FactClientWorkflow[prior_appt_end], TODAY(), DAY )
        )
    )
)

SLA 8 Status =
SWITCH (
    TRUE(),
    FactClientWorkflow[apptmnt_type] = "I", "Not A Recred",
    ISBLANK ( FactClientWorkflow[prior_appt_end] ), "No Prior Recred Date",
    NOT ISBLANK ( FactClientWorkflow[sent_to_client] ) && FactClientWorkflow[SLA 8 Time] > 0, "Completed Exceeded Time",
    NOT ISBLANK ( FactClientWorkflow[sent_to_client] ), "Completed On Time",
    FactClientWorkflow[SLA 8 Time] > 0, "Open Exceeded Time",
    FactClientWorkflow[SLA 8 Time] > -5, "Open At Risk",
    "Open"
)
